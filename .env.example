DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
SYSMON_ENABLE_SCHEDULER=false

# Enable only after installing requirements/ldap.txt.
DJANGO_ENABLE_LDAP=false

# External monitoring server used by the current integration code.
NAG_SERVER=
NAG_USERNAME=
NAG_PASSWORD=
SYSMON_SNMP_COMMUNITIES=public
SYSMON_LENOVO_SNMP_COMMUNITY=private
SYSMON_MAIL_PASSWORD=
SYSMON_MAIL_FROM=sysmon@example.com
SYSMON_MAIL_TO=admin@example.com
SYSMON_MAIL_SERVER=localhost
