DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_LOG_LEVEL=INFO
SYSMON_ENABLE_SCHEDULER=false

# Enable these only when production traffic is served through configured HTTPS.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_TRUST_PROXY_HTTPS=false

# Docker Compose uses PostgreSQL and Redis. Local runs keep SQLite and
# in-memory Channels when these variables are empty or omitted.
DJANGO_DB_ENGINE=sqlite
POSTGRES_DB=sysmon
POSTGRES_USER=sysmon
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
REDIS_URL=
SYSMON_PORT=8000

# Host directory populated by the Nagios synchronization cron job.
NAGIOS_STATUS_HOST_DIR=./nagios_stat

# Enable only after installing requirements/ldap.txt.
DJANGO_ENABLE_LDAP=false

# External monitoring server used by the current integration code.
NAG_SERVER=
NAG_USERNAME=
NAG_PASSWORD=
SYSMON_SNMP_COMMUNITIES=public
SYSMON_LENOVO_SNMP_COMMUNITY=private
SYSMON_MAIL_PASSWORD=
SYSMON_MAIL_FROM=
SYSMON_MAIL_TO=
SYSMON_MAIL_SERVER=localhost
